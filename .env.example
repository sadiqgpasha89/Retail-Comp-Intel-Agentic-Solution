# ═══════════════════════════════════════════════════════════════
#  Retail Competitor Intelligence Platform — Environment Config
#  Copy to .env and fill in credentials before running.
# ═══════════════════════════════════════════════════════════════

# Platform Identity
APP_NAME=RetailCompIntelAgentic
APP_ENV=development
LOG_LEVEL=INFO

# Execution Stack: "open_stack" (local/on-prem) or "gcp" (cloud-native GCP)
EXECUTION_MODE=open_stack

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS — comma-separated list of allowed origins (wildcards MUST NOT be used with credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Decision Boundaries (Tri-Tier Hybrid Split)
AUTO_COMMIT_THRESHOLD=0.92
AGENTIC_ESCALATION_THRESHOLD=0.65
REJECT_THRESHOLD=0.40

# Multimodal Weight Calibration: alpha*text + beta*vis + gamma*attr (fallback defaults)
DEFAULT_WEIGHT_TEXTUAL=0.45
DEFAULT_WEIGHT_VISUAL=0.35
DEFAULT_WEIGHT_ATTRIBUTES=0.20

# MLOps Drift Detection Tolerances
PSI_WARNING_THRESHOLD=0.10
PSI_CRITICAL_THRESHOLD=0.25
WASSERSTEIN_DRIFT_THRESHOLD=0.18
PAGE_HINKLEY_THRESHOLD=50.0

# LLM & Agentic AI — leave GEMINI_API_KEY blank to use the mock provider
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
AGENT_MAX_ITERATIONS=6
AGENT_STEP_BUDGET=10

# Storage & Persistence
DATABASE_URL=sqlite:///./data/retail_intel.db
VECTOR_DIMENSION=64
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_DIR=./data/payload_store

# Optional: override project root directory (useful in containers)
# RETAIL_INTEL_BASE_DIR=/app

# GCP Cloud Resource Bindings (active when EXECUTION_MODE=gcp)
GCP_PUBSUB_TOPIC_INGESTION=projects/retail-intel/topics/competitor-raw-ingest
GCP_PUBSUB_TOPIC_ALERTS=projects/retail-intel/topics/merch-action-alerts
GCP_BIGQUERY_DATASET=retail_competitive_intelligence
GCP_SPANNER_INSTANCE=retail-graph-instance
GCP_SPANNER_DATABASE=retail-knowledge-graph
GCP_GCS_BUCKET_PAYLOADS=retail-intel-raw-payloads-lake
